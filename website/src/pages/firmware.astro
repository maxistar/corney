---
import SiteLayout from '../layouts/SiteLayout.astro';
import Notice from '../components/Notice.astro';
import { project } from '../data/project.js';
import { recovery, releaseView, topologies } from '../data/firmware.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const release = releaseView();
---
<SiteLayout title="Choose your firmware" description="Choose Direct Bluetooth or USB Dongle and match each Corney controller to the correct UF2 firmware image." current="firmware">
  <div class="shell page-hero"><span class="eyebrow">Firmware / choose your path</span><h1>One set of parts.<br />Two ways to connect.</h1><p class="lead">First decide which device will be the central. Then flash every controller with the matching image from the same release.</p><div class="btn-row"><a class="btn" href="#direct">Direct Bluetooth</a><a class="btn btn-outline" href="#dongle">USB Dongle</a></div></div>

  <div class="shell release-band" aria-live="polite">
    <span class="release-icon" aria-hidden="true">●</span><div><strong>{release.label}</strong>{release.published ? <p>Version {release.version} · use every operating image from this compatibility set.</p> : <p>The guide below shows exact image names. Download buttons appear after a versioned set is published and physically accepted. You can <a href={project.docs.readme}>build from source</a> now.</p>}</div>
    {release.published && <a class="text-link" href={release.releaseUrl}>Open release ↗</a>}
  </div>

  <section class="shell section" aria-labelledby="choose-title"><div class="section-intro"><span class="eyebrow">Pick the central</span><h2 id="choose-title">Where will the host connect?</h2><p>The right half uses the same image in both paths. The left half needs a different image depending on whether it owns the central role.</p></div><div class="grid-2 chooser">
    {topologies.map((topology, index) => <a href={`#${topology.id}`}><span class="card-number">0{index + 1} / {topology.name}</span><span class="chooser-art" aria-hidden="true">{topology.id === 'direct' ? 'L ))) R' : 'L → ▣ ← R'}</span><h3>{topology.name}</h3><p>{topology.summary}</p><span class="text-link">View controller map ↘</span></a>)}
  </div></section>

  {topologies.map((topology, index) => <section class="shell section topology" id={topology.id} aria-labelledby={`${topology.id}-title`}><div class="topology-head"><span class="eyebrow">PATH / 0{index + 1}</span><h2 id={`${topology.id}-title`}>{topology.name}</h2><p>{topology.summary}</p></div><ol class="controller-list">{topology.controllers.map((controller, controllerIndex) => <li><span class="controller-number">0{controllerIndex + 1}</span><div><strong>{controller.role}</strong><span class="filename">{controller.artifact}</span>{release.published && <span class="checksum">SHA-256: {release.artifacts[controller.artifact].sha256}</span>}</div>{release.published ? <a class="btn" href={release.artifacts[controller.artifact].url} download>Download UF2 ↗</a> : <span class="pending">Release pending</span>}</li>)}</ol>{topology.id === 'direct' ? <p class="topology-note">The left half handles host Bluetooth and Keyboard Helper telemetry. The right half connects to it as a peripheral.</p> : <p class="topology-note">Flash the dedicated dongle and both halves. The dongle has no key matrix or trackpad of its own; it sends USB HID reports and drives the optional OLED.</p>}</section>)}

  {release.published && <section class="shell section"><div class="bundle-panel"><div><span class="eyebrow">One verified set</span><h2>Take all five files together.</h2><p>The bundle contains the three operating paths' five distinct UF2 images and <code>SHA256SUMS</code>. The reset image is for recovery only.</p></div><div class="bundle-actions"><a class="btn" href={release.bundleUrl}>Download bundle ↗</a><a class="text-link" href={release.checksumUrl}>View SHA256SUMS ↗</a></div></div></section>}

  <section class="shell section recovery" id="recovery" aria-labelledby="recovery-title"><span class="eyebrow">Recovery / separate from normal operation</span><h2 id="recovery-title">Settings reset</h2><Notice title="This erases stored ZMK settings and bonds." tone="warning"><p><code>{recovery.artifact}</code> is a temporary recovery image, not operating firmware. Flash it on the controller whose settings need clearing, let it boot, then flash the correct operating UF2 again. Re-pair devices afterward.</p></Notice><div class="reset-row"><div><span class="tag">Temporary image</span><strong>{recovery.artifact}</strong>{release.published && <span class="checksum">SHA-256: {release.artifacts[recovery.artifact].sha256}</span>}</div>{release.published ? <a class="btn btn-outline" href={release.artifacts[recovery.artifact].url} download>Download reset UF2 ↗</a> : <span class="pending">Release pending</span>}</div><p class="small">Switching between Direct Bluetooth and USB Dongle changes the central and invalidates existing split bonds. Reset settings on both halves and the dongle before its next use. Then flash the left half's new role image, keep <code>corney-right.uf2</code> on the right, and pair the central again.</p></section>

  <section class="shell section next-panel"><div><span class="eyebrow">Next step</span><h2>Ready to flash?</h2><p>Open the setup guide for bootloader, pairing and troubleshooting steps.</p></div><a class="btn" href={`${base}/guide/`}>Read setup guide ↗</a></section>
</SiteLayout>

<style>
.release-band{display:flex;align-items:flex-start;gap:16px;padding:22px 25px;background:#213127;border:1px solid #637e53;border-radius:10px}.release-icon{color:var(--accent);font-size:1.2rem;line-height:1.2}.release-band strong{font-family:'Space Grotesk Variable',sans-serif;font-size:1.15rem}.release-band p{margin:3px 0 0;color:#c4d2c3}.release-band .text-link{margin-left:auto;white-space:nowrap}.chooser>a{display:block;background:var(--panel);padding:27px;border:1px solid var(--border);border-radius:12px;text-decoration:none}.chooser>a:hover{border-color:var(--accent);color:var(--ink)}.chooser-art{display:block;font-family:'DM Mono',monospace;color:var(--accent);background:#0e1d22;border:1px dashed #58716a;border-radius:6px;font-size:1.35rem;text-align:center;letter-spacing:.24em;padding:28px 10px;margin:16px 0 24px}.chooser h3{font-size:1.8rem}.chooser p{color:var(--muted);min-height:60px}.topology{scroll-margin-top:35px}.topology-head{max-width:750px;margin-bottom:30px}.topology-head .eyebrow{display:block;margin-bottom:14px}.topology-head p,.topology-note{color:var(--muted);font-size:1.05rem}.controller-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--border)}.controller-list li{display:flex;align-items:center;gap:20px;border-bottom:1px solid var(--border);padding:21px 0;min-width:0}.controller-number{flex:0 0 50px;font-family:'DM Mono',monospace;color:var(--accent)}.controller-list li>div{min-width:0;flex:1}.controller-list strong,.controller-list .filename,.checksum{display:block}.controller-list strong{font-family:'Space Grotesk Variable',sans-serif;font-size:1.1rem}.filename,.reset-row strong{font-family:'DM Mono',monospace;color:var(--accent);font-size:.85rem;overflow-wrap:anywhere}.checksum{color:var(--muted);font-family:'DM Mono',monospace;font-size:.72rem;overflow-wrap:anywhere;margin-top:5px}.pending{color:#a4b2b1;border:1px solid var(--border);font-size:.77rem;border-radius:100px;padding:5px 10px;white-space:nowrap}.topology-note{margin-top:18px}.recovery{scroll-margin-top:30px}.recovery .eyebrow{display:block;margin-bottom:14px}.reset-row{border:1px solid #77634d;background:#241f1d;padding:22px;display:flex;align-items:center;justify-content:space-between;gap:20px;border-radius:8px;margin:20px 0}.reset-row strong{display:block;margin-top:8px}.recovery>.small{max-width:850px;line-height:1.7}.bundle-panel,.next-panel{background:#25362f;border:1px solid #6c8b73;border-radius:12px;padding:35px;display:flex;gap:35px;align-items:center;justify-content:space-between}.bundle-panel p,.next-panel p{color:var(--muted);max-width:650px;margin-bottom:0}.bundle-panel h2,.next-panel h2{font-size:2rem;margin:8px 0}.bundle-actions{display:flex;flex-direction:column;align-items:flex-start;gap:14px;flex-shrink:0}.next-panel>.btn{flex-shrink:0}
@media(max-width:700px){.controller-list li{align-items:flex-start;flex-wrap:wrap}.controller-list li>div{flex:1 1 calc(100% - 70px)}.controller-list li .btn,.controller-list li .pending{margin-left:70px}.reset-row,.bundle-panel,.next-panel{align-items:flex-start;flex-direction:column}.release-band{flex-wrap:wrap}.release-band .text-link{margin-left:0}.chooser p{min-height:0}}
@media(max-width:400px){.controller-number{flex-basis:28px}.controller-list li .btn,.controller-list li .pending{margin-left:48px}}
</style>
